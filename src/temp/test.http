}

###
# --------------------
# Event Controller
# --------------------

### Create a new event
POST {{baseUrl}}/events
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Test Event",
  "description": "This is a test event",
  "location": "Metaverse",
  "startTime": "2025-12-01T12:00:00.000Z",
  "endTime": "2025-12-01T15:00:00.000Z",
  "creatorWallet": "0x39c51157aeb811967d5185b454a883df82097265"
}

### Check in to a nearby event
POST {{baseUrl}}/events/check-in
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "eventId": "c91fef29-f5a4-4e74-b6ee-48bab97d95be",
  "verificationCode": "123456"
}

### Get all active events
GET {{baseUrl}}/events/active
Authorization: Bearer {{token}}

### Get a single event by ID
GET {{baseUrl}}/events/event-id-1
Authorization: Bearer {{token}}

### Admin check-in user by scanning QR
POST {{baseUrl}}/events/event-id-1/admin-check-in
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "userId": "user-id-2",
  "verificationCode": "654321"
}

### Offline check-in with code
POST {{baseUrl}}/events/offline-check-in
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "code": "BANGKOK2025"
}

### Get offline reward rates
GET {{baseUrl}}/events/offline-reward-rates
Authorization: Bearer {{token}}

###
# --------------------
# Fertilizer Controller
# --------------------

### Get fertilizer inventory
GET {{baseUrl}}/fertilizer/inventory
Authorization: Bearer {{token}}

### Apply fertilizer to a plant
POST {{baseUrl}}/fertilizer/apply
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "landId": "land-id-1",
  "fertilizerType": "FERTILIZER_COMMON"
}

### Compost fruits to create fertilizer
POST {{baseUrl}}/fertilizer/compost
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "fruitAmount": 10
}

###
# --------------------
# Inventory Controller
# --------------------

### Get user inventory
GET {{baseUrl}}/inventory
Authorization: Bearer {{token}}

### Get user inventory with category filter
GET {{baseUrl}}/inventory?category=SEEDS
Authorization: Bearer {{token}}

### Get inventory summary
GET {{baseUrl}}/inventory/summary
Authorization: Bearer {{token}}

### Add item to inventory (Admin/System)
POST {{baseUrl}}/inventory/add
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "itemType": "SEED_RARE",
  "amount": 10
}

### Remove item from inventory
DELETE {{baseUrl}}/inventory/remove
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "itemType": "SEED_COMMON",
  "amount": 1
}

### Transfer item to another user
POST {{baseUrl}}/inventory/transfer
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "recipientId": "user-id-2",
  "itemType": "FRUIT",
  "amount": 1
}

### Check if user has enough of an item
GET {{baseUrl}}/inventory/check/SEED_COMMON/5
Authorization: Bearer {{token}}

###
# --------------------
# Land Controller (Legacy)
# --------------------

### Get land by wallet address (Legacy)
GET {{baseUrl}}/land/0x39c51157aeb811967d5185b454a883df82097264
Authorization: Bearer {{token}}

### Assign a seed to a land (Legacy)
POST {{baseUrl}}/land/assign-seed
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "landId": "land-id-1",
  "seedId": "seed-id-1"
}

###
# --------------------
# Mission Controller
# --------------------

### Get all missions for current user
GET {{baseUrl}}/missions
Authorization: Bearer {{token}}

### Claim rewards for a completed mission
POST {{baseUrl}}/missions/0bb2f472-3b74-4790-b473-226ab003816c/claim
Authorization: Bearer {{token}}

###
# --------------------
# Phygital Controller
# --------------------

### Get Phygital Rewards
GET {{baseUrl}}/phygital/rewards
Authorization: Bearer {{token}}

### Redeem a Phygital Reward
POST {{baseUrl}}/phygital/redeem
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "rewardKey": "TOTE_BAG",
  "paymentType": "MUSHROOM",
  "contact": "@telegram_user",
  "shippingAddress": "123 Farm Lane, Metaverse City"
}

### Get Redemption History
GET {{baseUrl}}/phygital/redemptions
Authorization: Bearer {{token}}

###
# --------------------
# Plant Controller
# --------------------

### Get user's garden
GET {{baseUrl}}/garden
Authorization: Bearer {{token}}

### Plant a seed on a land plot
POST {{baseUrl}}/plant/plant
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "landId": "2a149acb-10d0-4108-9d55-63ea0113a0bd",
  "seedType": "ALGAE"
}

### Water a plant
PATCH {{baseUrl}}/plant/4b3bda37-fe47-4eec-9a7c-9c0f79ed246e/water
Authorization: Bearer {{token}}

### Harvest fruits from a mature plant
POST {{baseUrl}}/plant/plant-id-1/harvest
Authorization: Bearer {{token}}

### Interact with plant (Legacy)
PATCH {{baseUrl}}/plant/plant-id-1/interact
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "action": "social"
}

### Clear Land (Remove Plant)
DELETE {{baseUrl}}/land/2a149acb-10d0-4108-9d55-63ea0113a0bd/clear
Authorization: Bearer {{token}}

###
# --------------------
# Progression Controller
# --------------------

### Get XP & level progression
GET {{baseUrl}}/progression
Authorization: Bearer {{token}}

### Claim level-up rewards
POST {{baseUrl}}/progression/claim-level
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "level": 1
}

